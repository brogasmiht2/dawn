{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding bb-benefits-section">
  <div class="page-width">
    {%- if section.settings.subheading != blank or section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin center" style="margin-bottom: 3.5rem;">
        {%- if section.settings.subheading != blank -%}
          <span class="bb-eyebrow">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="rich-text__text rte" style="max-width: 650px; margin: 0 auto;">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bb-benefits-grid">
      {%- for block in section.blocks -%}
        <div class="bb-benefit-item" {{ block.shopify_attributes }}>
          <div class="bb-benefit-icon-wrapper">
            {%- case block.settings.icon -%}
              {%- when 'balcony' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18"></path>
                  <path d="M5 21V7l7-4 7 4v14"></path>
                  <path d="M9 10h6"></path>
                  <path d="M9 14h6"></path>
                  <path d="M9 18h6"></path>
                </svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              {%- when 'water' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                  <circle cx="12" cy="14" r="2"></circle>
                </svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                </svg>
              {%- when 'sun' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="5"></circle>
                  <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6L9 17l-5-5"></path>
                </svg>
            {%- endcase -%}
          </div>

          <h3 class="bb-benefit-title">{{ block.settings.title | escape }}</h3>
          <p class="bb-benefit-text">{{ block.settings.description | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand benefits",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Why BalconyBloomCo"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Designed for Living Big in Small Spaces"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every planter and accessory is engineered to eliminate urban gardening frustration: limited sunlight, restricted floor area, and dry wind.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "balcony",
              "label": "Balcony / Small Space"
            },
            {
              "value": "shield",
              "label": "Shield / Rust-Proof"
            },
            {
              "value": "water",
              "label": "Water / Self-Watering"
            },
            {
              "value": "leaf",
              "label": "Leaf / Growth Guarantee"
            },
            {
              "value": "sun",
              "label": "Sun / Sunlight"
            }
          ],
          "default": "balcony"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Small-Space Engineering"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Compact footprints, secure railing brackets, and vertical designs that leave space for your morning coffee."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "balcony",
            "title": "Small-Space Engineering",
            "description": "Secure brackets and modular vertical layouts that maximize yield without cluttering narrow balcony floors."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Weather-Tough & Rust-Proof",
            "description": "Powder-coated aluminum, UV-stable resin, and frost-proof ceramic engineered to endure high-rise winds."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "water",
            "title": "Smart Self-Watering Reservoirs",
            "description": "Built-in subirrigation protects roots during busy workdays and prevents water from dripping onto downstairs neighbors."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Urban Thriving Guarantee",
            "description": "Crafted and field-tested for apartments. If you are not delighted with your balcony transformation, returns are hassle-free."
          }
        }
      ]
    }
  ]
}
{% endschema %}
