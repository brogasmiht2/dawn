{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    assign has_newsletter_block = false
    for block in section.blocks
      if block.type == 'newsletter'
        assign has_newsletter_block = true
        break
      endif
    endfor
  -%}

  {%- if section.settings.show_trust_bar -%}
    <div class="footer__trust-bar">
      <div class="page-width">
        <div class="footer__trust-grid">
          <div class="footer__trust-item">
            <div class="footer__trust-icon-box" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
                <path d="M15 18H9"/>
                <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
                <circle cx="17" cy="18" r="2"/>
                <circle cx="7" cy="18" r="2"/>
              </svg>
            </div>
            <div class="footer__trust-text-group">
              <h3 class="footer__trust-heading">{{ section.settings.trust_heading_1 | default: 'Free Carbon-Neutral Shipping' }}</h3>
              <p class="footer__trust-subtext">{{ section.settings.trust_text_1 | default: 'On all qualifying orders over $50' }}</p>
            </div>
          </div>
          <div class="footer__trust-item">
            <div class="footer__trust-icon-box" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div class="footer__trust-text-group">
              <h3 class="footer__trust-heading">{{ section.settings.trust_heading_2 | default: '30-Day Space-Fit Guarantee' }}</h3>
              <p class="footer__trust-subtext">{{ section.settings.trust_text_2 | default: 'Love your balcony setup or return hassle-free' }}</p>
            </div>
          </div>
          <div class="footer__trust-item">
            <div class="footer__trust-icon-box" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            </div>
            <div class="footer__trust-text-group">
              <h3 class="footer__trust-heading">{{ section.settings.trust_heading_3 | default: 'Sustainably Engineered' }}</h3>
              <p class="footer__trust-subtext">{{ section.settings.trust_text_3 | default: 'UV-stabilized, non-toxic & recyclable materials' }}</p>
            </div>
          </div>
          <div class="footer__trust-item">
            <div class="footer__trust-icon-box" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                <path d="M8 10h.01"/>
                <path d="M12 10h.01"/>
                <path d="M16 10h.01"/>
              </svg>
            </div>
            <div class="footer__trust-text-group">
              <h3 class="footer__trust-heading">{{ section.settings.trust_heading_4 | default: 'Urban Plant Care Support' }}</h3>
              <p class="footer__trust-subtext">{{ section.settings.trust_text_4 | default: 'Balcony gardening specialists available 7 days' }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="footer__content-top page-width">
    {%- if section.blocks.size > 0 or section.settings.newsletter_enable -%}
      <div
        class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- for block in section.blocks -%}
          <div
            class="footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu{% elsif block.type == 'brand_information' %} footer-block--brand{% elsif block.type == 'newsletter' %} footer-block--newsletter-col{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                {%- endif -%}
                <div class="footer-block__details-content rte">
                  {{ block.settings.subtext }}
                </div>

              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                {%- endif -%}
                <ul class="footer-block__details-content list-unstyled">
                  {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  {%- endif -%}

                  {%- comment -%} Ensure rich e-commerce links if default menus are sparse {%- endcomment -%}
                  {%- assign heading_downcase = block.settings.heading | downcase -%}
                  {%- if heading_downcase contains 'care' or heading_downcase contains 'help' or heading_downcase contains 'support' or heading_downcase contains 'guide' -%}
                    {%- if block.settings.menu == blank or block.settings.menu.links.size < 4 -%}
                      <li><a href="/#guides" class="link link--text list-menu__item list-menu__item--link">Balcony Sizing & Railing Guide</a></li>
                      <li><a href="/policies/shipping-policy" class="link link--text list-menu__item list-menu__item--link">Shipping & Delivery Info</a></li>
                      <li><a href="/policies/refund-policy" class="link link--text list-menu__item list-menu__item--link">30-Day Guarantee & Returns</a></li>
                      <li><a href="/#faq" class="link link--text list-menu__item list-menu__item--link">Urban Gardening FAQs</a></li>
                      <li><a href="/pages/contact" class="link link--text list-menu__item list-menu__item--link">Contact Plant Specialists</a></li>
                    {%- endif -%}
                  {%- elsif heading_downcase contains 'shop' or heading_downcase contains 'product' or heading_downcase contains 'essential' -%}
                    {%- if block.settings.menu == blank or block.settings.menu.links.size < 4 -%}
                      <li><a href="/collections/all" class="link link--text list-menu__item list-menu__item--link">Balcony Railing Planters</a></li>
                      <li><a href="/collections/all" class="link link--text list-menu__item list-menu__item--link">Self-Watering Pots & Boxes</a></li>
                      <li><a href="/collections/all" class="link link--text list-menu__item list-menu__item--link">Compact Gardening Tools</a></li>
                      <li><a href="/collections/all" class="link link--text list-menu__item list-menu__item--link">Vertical Wall Planters</a></li>
                      <li><a href="/collections/all" class="link link--text list-menu__item list-menu__item--link">Best Sellers & Bundles</a></li>
                    {%- endif -%}
                  {%- endif -%}
                </ul>

              {%- when 'brand_information' -%}
                <div class="footer-block__brand-info">
                  {%- if settings.brand_image != blank -%}
                    {%- assign brand_image_height = settings.brand_image_width
                      | divided_by: settings.brand_image.aspect_ratio
                    -%}
                    <div
                      class="footer-block__image-wrapper"
                      style="max-width: min(100%, {{ settings.brand_image_width }}px);"
                    >
                      {{
                        settings.brand_image
                        | image_url: width: 1100
                        | image_tag:
                          loading: 'lazy',
                          widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
                          height: brand_image_height,
                          width: settings.brand_image_width
                      }}
                    </div>
                  {%- else -%}
                    <div class="footer-block__logo-wrapper">
                      <a href="{{ routes.root_url }}" class="footer__logo-link link link--text" aria-label="{{ shop.name | default: 'BalconyBloomCo' }}">
                        <img
                          src="{{ 'balconybloomco-logo.svg' | asset_url }}"
                          alt="{{ shop.name | default: 'BalconyBloomCo' }}"
                          class="footer__logo-image"
                          width="210"
                          height="40"
                          loading="lazy"
                        >
                      </a>
                    </div>
                  {%- endif -%}

                  {%- assign brand_headline = settings.brand_headline | default: 'Grow More in Less Space.' -%}
                  {%- if brand_headline != blank -%}
                    <p class="footer-block__tagline">{{ brand_headline }}</p>
                  {%- endif -%}

                  {%- assign brand_description = settings.brand_description | default: '<p>Thoughtfully engineered planters, tools, and accessories designed for balcony gardens and small-space living.</p>' -%}
                  <div class="footer-block__brand-desc rte">{{ brand_description }}</div>

                  <div class="footer-block__contact-card">
                    <div class="footer-block__contact-line">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                      </svg>
                      <a href="mailto:hello@balconybloomco.com" class="footer-block__contact-email">hello@balconybloomco.com</a>
                    </div>
                    <div class="footer-block__contact-hours">
                      <span class="footer-block__status-dot" aria-hidden="true"></span>
                      <span>Mon–Fri • Fast 24-Hour Response</span>
                    </div>
                  </div>

                  {%- if block.settings.show_social and has_social_icons -%}
                    <div class="footer-block__social-wrapper">
                      {%- render 'social-icons', class: 'footer__list-social' -%}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'newsletter' -%}
                <div class="footer-block__newsletter-col">
                  <span class="footer-block__newsletter-badge">10% OFF FIRST ORDER</span>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                  {%- endif -%}
                  {%- if block.settings.subtext != blank -%}
                    <div class="footer-block__newsletter-subtext rte">
                      {{ block.settings.subtext }}
                    </div>
                  {%- endif -%}
                  {%- form 'customer', id: 'ContactFooterBlock', class: 'footer__newsletter newsletter-form' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="newsletter-form__field-wrapper">
                      <div class="field">
                        <input
                          id="NewsletterForm--block--{{ section.id }}"
                          type="email"
                          name="contact[email]"
                          class="field__input"
                          value="{{ form.email }}"
                          aria-required="true"
                          autocorrect="off"
                          autocapitalize="off"
                          autocomplete="email"
                          {% if form.errors %}
                            autofocus
                            aria-invalid="true"
                            aria-describedby="ContactFooterBlock-error"
                          {% elsif form.posted_successfully? %}
                            aria-describedby="ContactFooterBlock-success"
                          {% endif %}
                          placeholder="Enter your email"
                          required
                        >
                        <label class="field__label" for="NewsletterForm--block--{{ section.id }}">
                          Enter your email
                        </label>
                        <button
                          type="submit"
                          class="newsletter-form__button field__button"
                          name="commit"
                          id="SubscribeBlock"
                          aria-label="{{ 'newsletter.button_label' | t }}"
                        >
                          <span class="svg-wrapper">
                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                          </span>
                        </button>
                      </div>
                      {%- if form.errors -%}
                        <small class="newsletter-form__message form__message" id="ContactFooterBlock-error">
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                          {{- form.errors.translated_fields.email | capitalize }}
                          {{ form.errors.messages.email -}}
                        </small>
                      {%- endif -%}
                    </div>
                    {%- if form.posted_successfully? -%}
                      <h3
                        class="newsletter-form__message newsletter-form__message--success form__message"
                        id="ContactFooterBlock-success"
                        tabindex="-1"
                        autofocus
                      >
                        <span class="svg-wrapper">
                          {{- 'icon-success.svg' | inline_asset_content -}}
                        </span>
                        {{- 'newsletter.success' | t }}
                      </h3>
                    {%- endif -%}
                  {%- endform -%}
                  <p class="footer-block__newsletter-privacy">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <span>No spam, ever. Unsubscribe at any time.</span>
                  </p>
                </div>

              {%- when 'image' -%}
                <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                  {%- if block.settings.image != blank -%}
                    {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
                    <div
                      class="footer-block__image-wrapper"
                      style="max-width: min(100%, {{ block.settings.image_width }}px);"
                    >
                      <img
                        srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                        src="{{ block.settings.image | image_url: width: 760 }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                      >
                    </div>
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                  {%- endif -%}
                </div>
            {%- endcase -%}
          </div>
        {%- endfor -%}

        {%- unless has_newsletter_block -%}
          {%- if section.settings.newsletter_enable -%}
            <div class="footer-block grid__item footer-block--newsletter-col{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
              <span class="footer-block__newsletter-badge">10% OFF FIRST ORDER</span>
              {%- if section.settings.newsletter_heading != blank -%}
                <h2 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
              {%- endif -%}
              <div class="footer-block__newsletter-subtext rte">
                <p>Enjoy 10% off your first order, plus seasonal balcony growing tips and exclusive small-batch releases.</p>
              </div>
              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="Enter your email"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                      Enter your email
                    </label>
                    <button
                      type="submit"
                      class="newsletter-form__button field__button"
                      name="commit"
                      id="Subscribe"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </span>
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                </div>
                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-success.svg' | inline_asset_content -}}
                    </span>
                    {{- 'newsletter.success' | t }}
                  </h3>
                {%- endif -%}
              {%- endform -%}
              <p class="footer-block__newsletter-privacy">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>No spam, ever. Unsubscribe at any time.</span>
              </p>
            </div>
          {%- endif -%}
        {%- endunless -%}
      </div>
    {%- endif -%}
  </div>

  <div
    class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__bottom-left">
        <div class="footer__copyright caption">
          <small class="copyright__content"
            >&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | default: 'BalconyBloomCo' }}. All rights reserved.
          </small>
        </div>
        {%- if section.settings.show_policy -%}
          <ul class="policies list-unstyled">
            {%- if shop.policies.size > 0 -%}
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li>
                    <small class="copyright__content">
                      <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                    </small>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <li><small class="copyright__content"><a href="/policies/privacy-policy">Privacy Policy</a></small></li>
              <li><small class="copyright__content"><a href="/policies/terms-of-service">Terms of Service</a></small></li>
              <li><small class="copyright__content"><a href="/policies/shipping-policy">Shipping Policy</a></small></li>
              <li><small class="copyright__content"><a href="/policies/refund-policy">Refund Policy</a></small></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__bottom-right">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- if shop.enabled_payment_types.size > 0 -%}
                {%- for type in shop.enabled_payment_types -%}
                  <li class="list-payment__item">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li class="list-payment__item">
                  <span class="bb-payment-pill" title="Visa">
                    <svg width="38" height="24" viewBox="0 0 38 24" fill="none" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#FFFFFF"/><path d="M15.4 16h-2.3l1.4-8.8h2.3l-1.4 8.8zm7.5-8.6c-.5-.2-1.2-.4-2.1-.4-2.3 0-4 1.2-4 3 0 1.3 1.2 2 2.1 2.4.9.4 1.2.7 1.2 1.1 0 .6-.7.9-1.4.9-1 0-1.5-.1-2.3-.5l-.3-.2-.3 2c.6.3 1.6.5 2.7.5 2.5 0 4.1-1.2 4.1-3.1 0-1-.6-1.8-2-2.5-.8-.4-1.3-.7-1.3-1.1 0-.4.4-.8 1.3-.8.7 0 1.3.2 1.7.3l.2.1.3-1.7zm6.7 4.1-.9 4.5h-2.1l1.4-8.8h2.2l.4 4.3zm-16.8-4.3-2.2 6-0.2-1.2c-.4-1.4-1.6-2.9-3-3.6l1.9 7.6h2.4l3.6-8.8h-2.5z" fill="#1A1F71"/></svg>
                  </span>
                </li>
                <li class="list-payment__item">
                  <span class="bb-payment-pill" title="Mastercard">
                    <svg width="38" height="24" viewBox="0 0 38 24" fill="none" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#FFFFFF"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8a6.96 6.96 0 0 1 2.6 5.2 6.96 6.96 0 0 1-2.6 5.2 6.96 6.96 0 0 1-2.6-5.2c0-2 1-3.8 2.6-5.2z" fill="#FF5F00"/></svg>
                  </span>
                </li>
                <li class="list-payment__item">
                  <span class="bb-payment-pill" title="American Express">
                    <svg width="38" height="24" viewBox="0 0 38 24" fill="none" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#006FCF"/><path d="M7 16h3.4l1.2-2.7h3.8l1.2 2.7H20l-4.5-9.6h-4L7 16zm5.8-4.4 1.1-2.4 1.1 2.4h-2.2zm10.7-5.2v9.6h6.8v-1.8h-4.7v-2.1h4.4v-1.8h-4.4v-2.1h4.7V6.4h-6.8z" fill="#FFFFFF"/></svg>
                  </span>
                </li>
                <li class="list-payment__item">
                  <span class="bb-payment-pill" title="Apple Pay">
                    <svg width="38" height="24" viewBox="0 0 38 24" fill="none" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#000000"/><path d="M15.5 11.2c0-1.2.9-1.9 1-2-.6-.8-1.5-1-1.8-1-.8-.1-1.5.5-1.9.5-.4 0-1-.5-1.7-.5-0.9 0-1.7.5-2.1 1.3-.9 1.6-.2 4 .7 5.2.4.6 1 1.3 1.7 1.3.7 0 .9-.4 1.7-.4.8 0 1 .4 1.7.4.7 0 1.2-.6 1.6-1.2.5-.7.7-1.4.7-1.5-.1 0-1.3-.5-1.3-1.6zm-1.1-3.3c.3-.4.5-1 .5-1.6 0-.1 0-.2 0-.2-.5 0-1.1.3-1.5.8-.3.3-.5.9-.5 1.5 0 .1 0 .2 0 .2.6 0 1.1-.3 1.5-.7z" fill="#FFFFFF"/><text x="18" y="14" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="7.5" font-weight="600">Pay</text></svg>
                  </span>
                </li>
                <li class="list-payment__item">
                  <span class="bb-payment-pill" title="Google Pay">
                    <svg width="38" height="24" viewBox="0 0 38 24" fill="none" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1"/><path d="M16.5 12.1c0-.4 0-.7-.1-1H12v2h2.5c-.1.6-.5 1.2-1 1.5v1.3h1.6c1-1 1.5-2.3 1.5-3.8z" fill="#4285F4"/><path d="M12 16.6c1.3 0 2.3-.4 3.1-1.1l-1.6-1.3c-.4.3-1 .5-1.5.5-1.2 0-2.2-.8-2.6-1.9H7.8v1.3c.8 1.6 2.4 2.5 4.2 2.5z" fill="#34A853"/><path d="M9.4 12.8c-.1-.3-.2-.7-.2-1s.1-.7.2-1V9.5H7.8c-.3.7-.5 1.5-.5 2.3 0 .8.2 1.6.5 2.3l1.6-1.3z" fill="#FBBC05"/><path d="M12 8.9c.7 0 1.3.2 1.8.7l1.4-1.4C14.3 7.4 13.2 7 12 7 10.2 7 8.6 7.9 7.8 9.5l1.6 1.3c.4-1.1 1.4-1.9 2.6-1.9z" fill="#EA4335"/><text x="17.5" y="14" fill="#5F6368" font-family="Roboto, sans-serif" font-size="7.5" font-weight="500">Pay</text></svg>
                  </span>
                </li>
                <li class="list-payment__item">
                  <span class="bb-payment-pill" title="PayPal">
                    <svg width="38" height="24" viewBox="0 0 38 24" fill="none" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#003087"/><path d="M13 17h2.2l1.4-8.8H13L13 17z" fill="#0079C1"/><path d="M16.6 8.2h3.5c1.8 0 3.2.7 3.2 2.5 0 2.2-1.6 3.5-3.5 3.5h-1.8l-.9 5.8h-2.3l1.9-11.8z" fill="#00457C"/><path d="M18.8 8.2h3.5c1.8 0 3.2.7 3.2 2.5 0 2.2-1.6 3.5-3.5 3.5h-1.8l-.9 5.8h-2.3l1.9-11.8z" fill="#0079C1"/></svg>
                  </span>
                </li>
                <li class="list-payment__item">
                  <span class="bb-payment-pill" title="Shop Pay">
                    <svg width="38" height="24" viewBox="0 0 38 24" fill="none" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#5A31F4"/><text x="7" y="15" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="8.5" font-weight="700">Shop<tspan font-weight="400">Pay</tspan></text></svg>
                  </span>
                </li>
              {%- endif -%}
            </ul>
            <div class="footer__ssl-badge">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span>256-Bit SSL Encrypted Checkout</span>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <div class="footer__localization isolate">
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          </div>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <div class="footer__localization isolate">
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="caption-large text-body" id="FooterLanguageLabel">
                    {{ 'localization.language_label' | t }}
                  </h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

