{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.subheading != blank or section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin center" style="margin-bottom: 2rem;">
        {%- if section.settings.subheading != blank -%}
          <span class="bb-eyebrow">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="rich-text__text rte" style="max-width: 650px; margin: 0 auto;">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bb-guides-grid">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
          <a href="{{ article.url }}" class="bb-guide-card">
            <div class="bb-guide-card__image-wrap">
              {%- if article.image -%}
                {{
                  article.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600',
                    class: 'motion-reduce',
                    alt: article.title | escape
                }}
              {%- endif -%}
            </div>
            <div class="bb-guide-card__content">
              <div class="bb-guide-card__meta">
                <span>{{ article.tags.first | default: 'Guide' }}</span>
                <span>•</span>
                <span>{{ article.published_at | time_tag: format: 'date' }}</span>
              </div>
              <h3 class="bb-guide-card__title">{{ article.title | escape }}</h3>
              <p class="bb-guide-card__excerpt">
                {%- if article.excerpt.size > 0 -%}
                  {{ article.excerpt | strip_html | truncatewords: 20 }}
                {%- else -%}
                  {{ article.content | strip_html | truncatewords: 20 }}
                {%- endif -%}
              </p>
              <span class="bb-guide-card__read-link">
                Read Guide
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M3 7h8M8 4l3 3-3 3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: routes.root_url }}" class="bb-guide-card" {{ block.shopify_attributes }}>
            <div class="bb-guide-card__image-wrap">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600',
                    class: 'motion-reduce',
                    alt: block.settings.title | escape
                }}
              {%- else -%}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-color: var(--bb-soft-sage);">
                  <svg aria-hidden="true" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--bb-forest-green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                    <path d="M6 6h10"></path>
                    <path d="M6 10h10"></path>
                  </svg>
                </div>
              {%- endif -%}
            </div>
            <div class="bb-guide-card__content">
              <div class="bb-guide-card__meta">
                <span>{{ block.settings.category | escape }}</span>
                <span>•</span>
                <span>{{ block.settings.read_time | escape }}</span>
              </div>
              <h3 class="bb-guide-card__title">{{ block.settings.title | escape }}</h3>
              <p class="bb-guide-card__excerpt">{{ block.settings.excerpt | escape }}</p>
              <span class="bb-guide-card__read-link">
                Read Guide
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M3 7h8M8 4l3 3-3 3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="center" style="margin-top: 3.5rem;">
        <a href="{{ section.settings.blog.url | default: '/blogs/news' }}" class="button button--secondary">
          {{ section.settings.view_all_label | default: 'View All Urban Guides' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Gardening inspiration",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Botanical Knowledge"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Gardening Inspiration & Guides"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Practical advice, plant care guides, and design tips written specifically for apartment balconies and compact urban spaces.</p>"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Connect Shopify Blog",
      "info": "If selected, recent blog articles will automatically appear here."
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of articles to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View All' button"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "default": "View All Urban Guides",
      "label": "View all button label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Curated guide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Guide image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category badge",
          "default": "Beginner Advice"
        },
        {
          "type": "text",
          "id": "read_time",
          "label": "Reading time",
          "default": "5 min read"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Guide title",
          "default": "The 5-Step Beginner's Guide to Balcony Gardening"
        },
        {
          "type": "text",
          "id": "excerpt",
          "label": "Short excerpt",
          "default": "How to assess sun hours, choose lightweight potting soil, and configure your first vertical planter."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Guide article link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gardening inspiration",
      "blocks": [
        {
          "type": "guide",
          "settings": {
            "category": "Starter Guide",
            "read_time": "5 min read",
            "title": "The 5-Step Beginner's Guide to High-Rise Balcony Gardening",
            "excerpt": "How to calculate your balcony sun hours, pick wind-tolerant herbs, and prevent moisture damage to railings."
          }
        },
        {
          "type": "guide",
          "settings": {
            "category": "Plant Care",
            "read_time": "4 min read",
            "title": "How to Protect Balcony Plants from High-Rise Winds and Summer Heat",
            "excerpt": "Simple sheltering techniques, self-watering strategies, and foliage staking that keep urban plants lush."
          }
        },
        {
          "type": "guide",
          "settings": {
            "category": "Harvesting",
            "read_time": "6 min read",
            "title": "7 Edible Herbs and Vegetables That Thrive in Shallow Planters",
            "excerpt": "From sweet basil to tumbling cherry tomatoes: delicious, high-yield edible varieties tailored for compact containers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
