{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.description != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin{% if section.settings.text_alignment == 'center' %} center{% endif %}">
        {%- if section.settings.subheading != blank -%}
          <span class="bb-eyebrow">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="rich-text__text rte" style="max-width: 680px; {% if section.settings.text_alignment == 'center' %}margin: 0 auto;{% endif %}">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bb-category-grid bb-category-grid--{{ section.settings.columns_desktop }}-col">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="bb-category-card"
          {{ block.shopify_attributes }}
        >
          <div class="bb-category-card__image-box">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '240, 360, 480, 600',
                  class: 'motion-reduce',
                  alt: block.settings.title | default: 'Category'
              }}
            {%- else -%}
              <div class="bb-category-card__icon-placeholder">
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <img src="{{ 'category-railing-planters.jpg' | asset_url }}" alt="Balcony Planters" loading="lazy" width="300" height="300" style="width: 100%; height: 100%; object-fit: cover;">
                  {%- when 2 -%}
                    {% comment %} Self-Watering Subirrigation Reservoir Icon {% endcomment %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                      <path d="M6 14c1.5 1 3.5 1 5 0s3.5-1 5 0"></path>
                    </svg>
                  {%- when 3 -%}
                    {% comment %} Precision Tools Icon {% endcomment %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 4l6 6-4 4-6-6 4-4z"></path>
                      <path d="M4 20l6-6"></path>
                      <path d="M3 21l2-2"></path>
                    </svg>
                  {%- when 4 -%}
                    {% comment %} Watering Accessories Icon {% endcomment %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 11l13-7v14L3 11z"></path>
                      <path d="M19 9h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2"></path>
                      <path d="M7 11V6a2 2 0 0 1 2-2h2"></path>
                    </svg>
                  {%- else -%}
                    {% comment %} Vertical Gardening Trellis Icon {% endcomment %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                      <path d="M3 9h18"></path>
                      <path d="M3 15h18"></path>
                      <path d="M9 3v18"></path>
                      <path d="M15 3v18"></path>
                    </svg>
                {%- endcase -%}
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.badge != blank -%}
            <span class="bb-category-card__tag">{{ block.settings.badge | escape }}</span>
          {%- endif -%}

          <h3 class="bb-category-card__title">{{ block.settings.title | escape }}</h3>

          {%- if block.settings.description != blank -%}
            <p class="bb-category-card__desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}

          <span class="bb-category-card__link-text">
            {{ block.settings.link_text | default: 'Shop Category' }}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M3 7h8M8 4l3 3-3 3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted For Compact Spaces"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtfully proportioned gardening essentials engineered for apartment balconies, railings, windowsills, and small urban patios.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 5,
      "label": "Number of columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge label",
          "default": "Space Saver"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Railing & Wall Planters"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Secure mounting brackets and lightweight designs that leave floor space clear."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Explore Planters"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "badge": "Space Saver",
            "title": "Railing & Wall Planters",
            "description": "Secure brackets and lightweight profiles that keep your balcony floor clear.",
            "link_text": "Explore Planters"
          }
        },
        {
          "type": "category",
          "settings": {
            "badge": "Ergonomic & Compact",
            "title": "Precision Small-Space Tools",
            "description": "Short-handle trowels, snips, and soil scoops designed for potting on small tables.",
            "link_text": "Shop Tools"
          }
        },
        {
          "type": "category",
          "settings": {
            "badge": "No-Drip Flow",
            "title": "Compact Watering Solutions",
            "description": "Long-spout cans and gentle misters that prevent spills on neighbors below.",
            "link_text": "See Watering"
          }
        },
        {
          "type": "category",
          "settings": {
            "badge": "Grow Upward",
            "title": "Vertical Garden Trellises",
            "description": "Climbing supports and modular wall trellises to expand your growing area.",
            "link_text": "View Trellises"
          }
        },
        {
          "type": "category",
          "settings": {
            "badge": "Beginner Friendly",
            "title": "Windowsill Herb Kits",
            "description": "Complete curated sets with seeds, organic soil pods, and compact planters.",
            "link_text": "Discover Herb Kits"
          }
        }
      ]
    }
  ]
}
{% endschema %}
