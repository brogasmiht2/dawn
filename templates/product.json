{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "tab_dimensions": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dimensions & Balcony Sizing",
            "icon": "ruler",
            "content": "<p>Engineered for compact urban spaces. Designed with shallow depths and lightweight materials that fit standard apartment railings, narrow ledges, and windowsills without encroaching on walkway space.</p>"
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Planting & Care Guide",
            "icon": "plant",
            "content": "<p>Built-in overflow drainage channels protect plant roots from overwatering and heavy city rains. The bottom reservoir provides steady capillary moisture for up to 7-10 days between waterings.</p>"
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & 30-Day Guarantee",
            "icon": "recycle",
            "content": "<p>Shipped in 100% recyclable, plastic-free packaging. Protected by our 30-Day Urban Thriving Guarantee: if your plants don't thrive or the fit isn't right, return for a full refund or exchange.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "tab_dimensions",
        "tab_care",
        "tab_shipping",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 24
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Pairs Well on Small Balconies",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-5",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 44,
        "padding_bottom": 44
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
